# Production/demo UI uses the real Zingo CLI adapter. Use mock only in unit tests.
SHADEGUARD_MODE=zingo
SHADEGUARD_NETWORK=testnet
SHADEGUARD_AUDIT_PATH=.shadeguard/audit.jsonl
SHADEGUARD_SPEND_LEDGER_PATH=.shadeguard/spend-ledger.jsonl
SHADEGUARD_APPROVAL_SOCKET=.shadeguard/approval.sock
SHADEGUARD_WEB_HOST=127.0.0.1
SHADEGUARD_WEB_PORT=4173

# Deterministic spending policy, expressed as decimal ZEC strings.
SHADEGUARD_MAX_PER_TX_ZEC=0.10
SHADEGUARD_DAILY_LIMIT_ZEC=0.50
SHADEGUARD_APPROVAL_ABOVE_ZEC=0.05

# Ironwood-compatible Zingo CLI light-client adapter (SHADEGUARD_MODE=zingo).
# Local release binary built from the pinned official Zingo source.
ZINGO_CLI_PATH=.shadeguard/zingolib/target/release/zingo-cli
ZINGO_DATA_DIR=.shadeguard/zingo-testnet
ZINGO_SERVER_URL=https://testnet.zec.rocks:443
ZINGO_WAIT_FOR_SYNC=true
ZINGO_COMMAND_TIMEOUT_MS=180000
ZINGO_FEE_RESERVE_ZATOSHI=100000

# Legacy Zallet testnet JSON-RPC adapter (only used when SHADEGUARD_MODE=zallet).
ZALLET_RPC_URL=http://127.0.0.1:40232
# Prefer the local Zallet cookie generated by scripts/testnet.sh.
ZALLET_RPC_COOKIE_PATH=.shadeguard/testnet/zallet.cookie
# Static Basic Auth is supported for custom deployments when no cookie path is set.
ZALLET_RPC_USER=
ZALLET_RPC_PASSWORD=
ZALLET_ACCOUNT_ID=
ZALLET_FUND_SOURCE=orchard

# Optional downstream Zcash MCP adapter (SHADEGUARD_MODE=mcp).
ZCASH_MCP_COMMAND=
ZCASH_MCP_ARGS_JSON=[]
ZCASH_MCP_CAN_AFFORD_TOOL=can_afford
ZCASH_MCP_SEND_TOOL=safe_send
ZCASH_MCP_STATUS_TOOL=get_payment_status
ZCASH_MCP_RECEIVE_TOOL=get_receive_address
ZCASH_MCP_AMOUNT_UNIT=zec

# Hosted AI performs intent understanding only. It never makes policy decisions.
# NVIDIA's Developer Program endpoint is the default free prototyping path.
AI_PROVIDER=nvidia
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Free NVIDIA Developer Program endpoint for development/prototyping.
# Set AI_PROVIDER=nvidia and obtain an nvapi-... key from https://build.nvidia.com/.
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_API_KEY=
