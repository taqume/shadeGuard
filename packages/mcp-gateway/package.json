{
  "name": "@shadeguard/mcp-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "shadeguard-mcp": "./dist/server.js",
    "shadeguard-approval": "./dist/approval-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "approval": "tsx src/approval-cli.ts",
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@shadeguard/approval-service": "workspace:*",
    "@shadeguard/core": "workspace:*",
    "@shadeguard/zcash-adapter": "workspace:*",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0"
  }
}
